# Barber Prime - variáveis de ambiente (todas opcionais)
# Copie para .env e ajuste se necessário. O servidor não carrega .env
# automaticamente; exporte as variáveis no shell ou use seu gerenciador.

# Porta HTTP (padrão: 3000)
PORT=3000

# Caminho do banco SQLite (padrão: data/barberprime.db)
# Use DB_PATH=:memory: para um banco efêmero (testes).
DB_PATH=data/barberprime.db

# Senha do usuário admin semeado (padrão: admin123)
ADMIN_SENHA=admin123

# Senha dos barbeiros semeados barbeiro1..barbeiro4 (padrão: barbeiro123)
BARBEIRO_SENHA=barbeiro123
